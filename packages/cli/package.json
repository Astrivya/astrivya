{
  "name": "@astrivya/cli",
  "version": "0.2.1",
  "description": "Astrivya CLI — local knowledge graph management for AI coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "atlas/", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsup && node ../../scripts/copy-atlas.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/cli.e2e.mjs"
  },
  "dependencies": {
    "@astrivya/akg-core": "^0.2.0",
    "@astrivya/akg-indexer": "^0.2.0",
    "@astrivya/plugin-runtime": "^0.2.0",
    "@inquirer/prompts": "^7.5.0",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "env-paths": "^2.2.1",
    "open": "11.0.0",
    "ora": "^8.2.0",
    "sql.js": "^1.14.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "keywords": ["cli", "knowledge-graph", "local-first", "astrivya"],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "astrivya": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astrivya/astrivya.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/astrivya/astrivya/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/astrivya/astrivya/issues"
  }
}
