{
  "name": "@astrivya/akg-core",
  "version": "0.2.1",
  "description": "Astrivya Knowledge Graph engine — SQLite-embedded, FTS5, vector embeddings, graph traversal, impact analysis, 3-way merge sync",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "env-paths": "^2.2.1",
    "sql.js": "^1.14.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/sql.js": "^1.4.11",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "keywords": ["knowledge-graph", "sqlite", "fts5", "graph-traversal", "impact-analysis", "astrivya"],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astrivya/astrivya.git",
    "directory": "packages/akg-core"
  },
  "homepage": "https://github.com/astrivya/astrivya/tree/main/packages/akg-core#readme",
  "bugs": {
    "url": "https://github.com/astrivya/astrivya/issues"
  }
}
