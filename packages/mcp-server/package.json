{
  "name": "@astrivya/mcp-server",
  "version": "0.5.0",
  "description": "Model Context Protocol server for Astrivya Knowledge Graph — 18 tools for AI coding agents to read/write/query the AKG",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "opencode-plugin/", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrivya/akg-indexer": "^0.5.0",
    "@astrivya/plugin-api": "^0.5.0",
    "@astrivya/plugin-runtime": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "env-paths": "^2.2.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@astrivya/akg-core": "^0.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "keywords": ["mcp", "model-context-protocol", "llm", "knowledge-graph", "astrivya"],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "astrivya-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astrivya/astrivya.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/astrivya/astrivya/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/astrivya/astrivya/issues"
  }
}
