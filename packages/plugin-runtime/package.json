{
  "name": "@astrivya/plugin-runtime",
  "version": "0.5.0",
  "description": "Astrivya Plugin Runtime — lifecycle management for plugins",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist/", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
