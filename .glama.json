{
  "$schema": "https://glama.ai/mcp/schemas/config.json",
  "name": "@astrivya/mcp-server",
  "description": "Persistent knowledge graph for AI coding agents — store decisions, search memories, trace dependencies",
  "command": "npx",
  "args": ["-y", "@astrivya/mcp-server"],
  "env": {
    "ASTRIVYA_WORKSPACE_PATH": {
      "description": "Workspace root path",
      "required": false
    }
