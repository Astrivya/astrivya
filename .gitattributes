# Auto-detect text files
* text=auto

# TypeScript
*.ts text diff=typescript
*.tsx text diff=typescript

# JSON
*.json text

# Markdown
*.md text

# Lock files — treat as binary to avoid merge conflicts
package-lock.json binary

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text

# Generated files
dist/** linguist-generated=true

# Force LF on checkout for biome-checked sources (biome and .editorconfig
# require LF; without this, Windows checkouts re-introduce CRLF and
# `npm run lint` fails on format checks)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
